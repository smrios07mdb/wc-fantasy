# Copy to `.env` and fill in. NEVER commit real secrets (.env is gitignored).
# All timestamps are stored in UTC; "league-local" exists only for the FAAB
# batch clock + display (ARCHITECTURE.md §8).

# --- Database (Supabase Postgres) ---------------------------------------------
# Pooled connection (PgBouncer, port 6543 on Supabase) used by the app at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wcfantasy?schema=public"
# Direct connection (no pooler, port 5432) used by Prisma Migrate + introspection.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/wcfantasy?schema=public"

# --- Supabase (Auth + Realtime) -----------------------------------------------
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
# Server-only. Bypasses RLS — never expose to the browser / never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Public values that are safe to ship in the Next.js client bundle:
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- BALLDONTLIE FIFA World Cup feed (GOAT tier, $39.99/mo) --------------------
BALLDONTLIE_API_KEY="your-feed-api-key"
BALLDONTLIE_BASE_URL="https://api.balldontlie.io"
# Rate cap (req/min). 5 = the 48h dev trial (default); set 600 for a paid GOAT key.
BALLDONTLIE_RPM="5"

# --- Worker / scheduler -------------------------------------------------------
# No-op scheduler tick interval (ms). The live poll loop (~60s) lands in a later prompt.
WORKER_TICK_MS="60000"
LOG_LEVEL="info"

# --- Sofascore scraper (isolated worker, Prompt 05b) --------------------------
# Settle-loop tick (ms) — slow + polite; the rating lands near/after FT.
SCRAPER_TICK_MS="300000"
# Polite gap between match-page fetches (ms).
SCRAPER_POLITE_GAP_MS="4000"
