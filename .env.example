# Copy to `.env` and fill in. NEVER commit real secrets (.env is gitignored).
# All timestamps are stored in UTC; "league-local" exists only for the FAAB
# batch clock + display (ARCHITECTURE.md §8).

# --- Database (Supabase Postgres) ---------------------------------------------
# Pooled connection (PgBouncer, port 6543 on Supabase) used by the app at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wcfantasy?schema=public"
# Direct connection (no pooler, port 5432) used by Prisma Migrate + introspection.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/wcfantasy?schema=public"

# --- Supabase (Auth + Realtime) -----------------------------------------------
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
# Server-only. Bypasses RLS — never expose to the browser / never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Public values that are safe to ship in the Next.js client bundle:
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Auth is magic-link by default. Set to "true" to also show the (config-gated) Google OAuth button —
# requires the Google provider to be enabled in the Supabase dashboard. Magic-link never blocks on this.
NEXT_PUBLIC_SUPABASE_GOOGLE_ENABLED="false"
# Supabase Auth → URL Configuration must allowlist the callback: <site>/auth/callback (+ localhost).
# Public origin for server-side auth redirects (callback, sign-out).
# Production (Render): set to the deployed URL. Local: leave unset → falls back to the request origin.
SITE_URL=

# --- BALLDONTLIE FIFA World Cup feed (GOAT tier, $39.99/mo) --------------------
BALLDONTLIE_API_KEY="your-feed-api-key"
BALLDONTLIE_BASE_URL="https://api.balldontlie.io"
# Rate cap (req/min). 5 = the 48h dev trial (default); set 600 for a paid GOAT key.
BALLDONTLIE_RPM="5"

# --- Worker / scheduler -------------------------------------------------------
# Ingestion scheduler tick interval (ms). The live poll loop (~60s) lands in a later prompt.
WORKER_TICK_MS="60000"
# Draft clock tick (ms) — its OWN short cadence so an expired pick_deadline_at autopicks within
# seconds (NOT coupled to the coarse ingestion tick). Server-authoritative timer (ARCHITECTURE §5).
WORKER_DRAFT_TICK_MS="2000"
# Rosters squad-sync (player + fifa_team bootstrap) cadence, in ticks. Squads are static, so this is
# SLOW: default 1440 (~daily at a 60s tick), plus always the boot tick. One-shot: `job:rosters`.
WORKER_ROSTERS_SYNC_EVERY_TICKS="1440"
LOG_LEVEL="info"

# --- Provisioning CLI (runbook A4–A5; `pnpm --filter @app/worker provision ...`) --------------
# Path to the league config (default: <repo-root>/provision.config.json — gitignored; copy the
# committed provision.config.example.json). Holds names/emails/timer only — no secrets.
# PROVISION_CONFIG="./provision.config.json"
# Path to a best-first JSON array of balldontlie player ids for `provision rank` (default_rank source).
# PROVISION_RANKING="./provision.ranking.json"

# --- Sofascore scraper (isolated worker, Prompt 05b) --------------------------
# Settle-loop tick (ms) — slow + polite; the rating lands near/after FT.
SCRAPER_TICK_MS="300000"
# Polite gap between match-page fetches (ms).
SCRAPER_POLITE_GAP_MS="4000"
